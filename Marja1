        function saveData() {
            localStorage.setItem('marja_master_db', JSON.stringify(db));
            renderAll();
        }

        function renderAll() {
            const container = document.getElementById('groupedSystemsContainer');
            const searchVal = document.getElementById('searchInput').value.toLowerCase();
            container.innerHTML = '';

            let fieldsMap = {};

            db.forEach(sys => {
                let matchSys = sys.name.toLowerCase().includes(searchVal) || sys.field.toLowerCase().includes(searchVal);
                let filteredArticles = sys.articles.filter(a => 
                    a.number.toLowerCase().includes(searchVal) || 
                    a.text.toLowerCase().includes(searchVal) || 
                    (a.explanation && a.explanation.toLowerCase().includes(searchVal)) ||
                    (a.example && a.example.toLowerCase().includes(searchVal)) ||
                    (a.crossLinks && a.crossLinks.toLowerCase().includes(searchVal)) ||
                    a.circulars.some(c => c.toLowerCase().includes(searchVal)) ||
                    a.judgments.some(j => j.toLowerCase().includes(searchVal))
                );

                if (matchSys || filteredArticles.length > 0) {
                    if (!fieldsMap[sys.field]) fieldsMap[sys.field] = [];
                    fieldsMap[sys.field].push({ ...sys, displayedArticles: matchSys ? sys.articles : filteredArticles });
                }
            });

            if (Object.keys(fieldsMap).length === 0) {
                container.innerHTML = `<div class="text-center py-12 text-gray-400 bg-white rounded-2xl border border-dashed border-gray-300">لا توجد نتائج مطابقة لبحثك</div>`;
                return;
            }

            for (let field in fieldsMap) {
                let groupWrapper = document.createElement('div');
                groupWrapper.className = 'space-y-4';
                
                let groupHeader = `
                    <div class="flex items-center gap-3 border-b-2 border-gold-500/40 pb-2">
                        <span class="text-lg">📁</span>
                        <h2 class="text-xl font-black text-emerald-950">مجال: ${field}</h2>
                        <span class="text-xs bg-emerald-900 text-gold-400 px-2 py-0.5 rounded-full">${fieldsMap[field].length} نظام/فرع</span>
                    </div>
                `;

                let systemsGrid = document.createElement('div');
                systemsGrid.className = 'space-y-6 mt-4';

                fieldsMap[field].forEach(sys => {
                    let sysCard = document.createElement('div');
                    sysCard.className = 'bg-white rounded-2xl border border-gold-500/30 shadow-sm p-6 space-y-4';
                    
                    let articlesHTML = '';
                    if (sys.displayedArticles.length === 0) {
                        articlesHTML = `<p class="text-xs text-gray-400 italic">لم تدرج مواد أو مبادئ تحت هذا النظام بعد.</p>`;
                    } else {
                        sys.displayedArticles.forEach(art => {
                            articlesHTML += `
                                <div class="bg-paper p-4 rounded-xl border-r-4 border-emerald-800 space-y-3">
                                    <div class="font-bold text-emerald-950 text-base flex justify-between items-center border-b pb-2 border-gold-500/10">
                                        <span>📜 ${art.number}</span>
                                        ${art.crossLinks ? `<span class="text-xs bg-gold-500/20 text-emerald-950 px-2.5 py-1 rounded-lg border border-gold-500/30">🔗 ارتباط نظامي: ${art.crossLinks}</span>` : ''}
                                    </div>
                                    <p class="text-xs text-gray-800 leading-relaxed font-medium">${art.text}</p>

                                    <!-- Explanation & Example -->
                                    ${(art.explanation || art.example) ? `
                                        <div class="grid grid-cols-1 md:grid-cols-2 gap-2 text-xs pt-2">
                                            ${art.explanation ? `<div class="bg-white p-2.5 rounded-lg border border-gray-200"><strong>💡 الشرح القانوني:</strong> ${art.explanation}</div>` : ''}
                                            ${art.example ? `<div class="bg-white p-2.5 rounded-lg border border-gray-200"><strong>📝 مثال تطبيقي:</strong> ${art.example}</div>` : ''}
                                        </div>
                                    ` : ''}

                                    <!-- Circulars & Judgments -->
                                    <div class="space-y-1.5 pt-2">
                                        ${art.circulars && art.circulars.length > 0 ? `
                                            <div class="text-xs bg-emerald-50/60 p-2 rounded-lg border border-emerald-900/10 text-emerald-900">
                                                <strong>📢 اللوائح التنفيذية والتعاميم:</strong> ${art.circulars.join(' | ')}
                                            </div>
                                        ` : ''}
                                        ${art.judgments && art.judgments.length > 0 ? `
                                            <div class="text-xs bg-amber-50/60 p-2 rounded-lg border border-amber-900/10 text-amber-950">
                                                <strong>⚖️ السوابق والمبادئ القضائية (المجلس الأعلى/المحكمة العليا):</strong> ${art.judgments.join(' | ')}
                                            </div>
                                        ` : ''}
                                    </div>
                                </div>
                            `;
                        });
                    }

                    sysCard.innerHTML = `
                        <div class="flex justify-between items-start border-b pb-3">
                            <div>
                                <span class="text-xs bg-emerald-100 text-emerald-800 px-2.5 py-1 rounded-lg font-bold">${sys.status}</span>
                                <h3 class="text-xl font-black text-emerald-950 mt-1">${sys.name}</h3>
                            </div>
                            <button onclick="deleteSystem(${sys.id})" class="text-red-500 hover:text-red-700 text-xs font-bold">حذف النظام</button>
                        </div>
                        <div class="space-y-3">
                            ${articlesHTML}
                        </div>
                    `;
                    systemsGrid.appendChild(sysCard);
                });

                groupWrapper.innerHTML = groupHeader;
                groupWrapper.appendChild(systemsGrid);
                container.appendChild(groupWrapper);
            }
            updateDropdown();
        }

        function openNewSystemModal() { document.getElementById('newSystemModal').classList.remove('hidden'); }
        function closeNewSystemModal() { document.getElementById('newSystemModal').classList.add('hidden'); }
        function openContentModal() { document.getElementById('contentModal').classList.remove('hidden'); }
        function closeContentModal() { document.getElementById('contentModal').classList.add('hidden'); }

        function saveNewSystem() {
            let name = document.getElementById('sysName').value.trim();
            let field = document.getElementById('sysField').value.trim() || "أنظمة عامة";
            if (!name) return alert('أدخل اسم النظام');
            db.push({
                id: Date.now(),
                name: name,
                field: field,
                status: document.getElementById('sysStatus').value,
                articles: []
            });
            saveData();
            closeNewSystemModal();
            document.getElementById('sysName').value = '';
            document.getElementById('sysField').value = '';
        }

        function saveArticle() {
            let sysId = Number(document.getElementById('contentSysId').value);
            let number = document.getElementById('artNumber').value.trim();
            let text = document.getElementById('artText').value.trim();
            let explanation = document.getElementById('artExplanation').value.trim();
            let example = document.getElementById('artExample').value.trim();
            let crossLinks = document.getElementById('artCrossLinks').value.trim();
            
            let circularsRaw = document.getElementById('artCirculars').value.trim();
            let judgmentsRaw = document.getElementById('artJudgments').value.trim();

            let circulars = circularsRaw ? circularsRaw.split('|').map(s => s.trim()) : [];
            let judgments = judgmentsRaw ? judgmentsRaw.split('|').map(s => s.trim()) : [];

            if (!number || !text) return alert('أدخل رقم المادة ونصها');
            let sys = db.find(s => s.id === sysId);
            if (sys) {
                sys.articles.push({ number, text, explanation, example, crossLinks, circulars, judgments });
                saveData();
                closeContentModal();
                document.getElementById('artNumber').value = '';
                document.getElementById('artText').value = '';
                document.getElementById('artExplanation').value = '';
                document.getElementById('artExample').value = '';
                document.getElementById('artCrossLinks').value = '';
                document.getElementById('artCirculars').value = '';
                document.getElementById('artJudgments').value = '';
            }
        }

        function deleteSystem(id) {
            if (confirm('حذف هذا النظام ومواده؟')) {
                db = db.filter(s => s.id !== id);
                saveData();
            }
        }

        function updateDropdown() {
            let sel = document.getElementById('contentSysId');
            sel.innerHTML = '';
            db.forEach(sys => {
                let opt = document.createElement('option');
                opt.value = sys.id;
                opt.innerText = `${sys.name} (${sys.field})`;
                sel.appendChild(opt);
            });
        }

        renderAll();
    </script>
</body>
</html>
